# Insumos brutos e intermediários de análise: ficam no disco, fora do versionamento.
# data/*.json (as semanas do portal) CONTINUA versionado — é o produto.
data/raw/
data/processed/
__pycache__/

tools/.bf_*
tools/.body_*
tools/_cands.json
tools/backfill_report.json
tools/verif_report.json
# trabalho/<semana>/ é VERSIONADO (a rotina na nuvem continua de um dia para o outro);
# só os prompts e o backup da memória ficam fora.
trabalho/**/prompt_*.md
trabalho/**/sinais_antes.json
trabalho/**/temas_antes.json
ferramentas/*.log
